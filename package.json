{
  "name": "dish-monitor",
  "version": "0.1.1",
  "description": "Live monitor for one or two Starlink-compatible dishes (unofficial)",
  "author": "jasondmillwood",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasondmillwood/dish-monitor.git"
  },
  "homepage": "https://github.com/jasondmillwood/dish-monitor",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts && bash test/installer.test.sh",
    "start:tsx": "NODE_ENV=production tsx server/index.ts",
    "pretest": "tsc -p tsconfig.server.json && vite build --config client/vite.config.ts --logLevel error"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.13",
    "fastify": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
